# Production Backend Environment Configuration Template
# Set these in your Render / Koyeb Web Service Dashboard -> Environment

# PostgreSQL database URI from Neon.tech or Supabase (Free Tier)
# Example: postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/protectpro?sslmode=require

# Random high-entropy secret key for JWT token signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-secure-random-secret-key-for-production

# Allowed frontend origin URLs (comma-separated), or * for permissive
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173
